{{- $k := .kiro -}}
{{- /* ── MCP servers this agent uses ── */}}
{{- $mcps := list
    (dict "key" "kirocrew_core" "groups" (list "default"))
    (dict "key" "kirocrew_cron" "groups" (list "default"))
    (dict "key" "grafana_non_prod" "groups" (list "read_only" "write"))
    (dict "key" "grafana_prod" "groups" (list "read_only"))
    (dict "key" "aws" "groups" (list "read_only" "write"))
    (dict "key" "ent_a2rm" "groups" (list "read_only"))
    (dict "key" "ent_confluence" "groups" (list "read_only"))
    (dict "key" "ent_jira" "groups" (list "read_only"))
    (dict "key" "ent_msgraph" "groups" (list "read_only"))
    (dict "key" "ent_gitlab" "groups" (list "read_only" "write"))
    (dict "key" "chrome" "groups" (list "read_only" "write"))
-}}
{{- /* ── Build allowedTools from KAS settings ── */}}
{{- $tools := list -}}
{{- range $k.kas.gate_answered_tools -}}
{{-   $tools = append $tools . -}}
{{- end -}}
{{- range $k.kas.policy_approved_tools -}}
{{-   $tools = append $tools . -}}
{{- end -}}
{{- $servers := dict -}}
{{- range $mcps -}}
{{-   $mcp := index $k.mcp_servers .key -}}
{{-   $config := dict -}}
{{-   if hasKey $mcp "config" -}}
{{-     $config = $mcp.config -}}
{{-   else if eq $.chezmoi.os "windows" -}}
{{-     $config = $mcp.config_windows -}}
{{-   else -}}
{{-     $config = $mcp.config_linux -}}
{{-   end -}}
{{-   $_ := set $servers $mcp.name $config -}}
{{-   range $group := .groups -}}
{{-     range $tool := index $mcp.allowed_tools $group -}}
{{-       $tools = append $tools (printf "@%s/%s" $mcp.name $tool) -}}
{{-     end -}}
{{-   end -}}
{{- end -}}
{{- /* ── No toolsSettings or permissions deny rules for Crew/KAS.            */}}
{{- /* On KAS, ANY non-allow rule or toolsSettings entry for a built-in      */}}
{{- /* capability triggers "author has restrictions" and WITHHOLDS the gate   */}}
{{- /* auto-answer — causing prompts for every call.                          */}}
{{- /* Crew's built-in deny floor already covers git push (structural parse)  */}}
{{- /* and sensitive paths (~/.aws/credentials etc), so user denies are       */}}
{{- /* redundant here.                                                        */}}
{{- /* ── Assemble config ── */}}
{{- $config := dict
    "name" "crew-general"
    "description" "Default agent with Kiro Crew tools"
    "prompt" (printf "file://%s/.kiro/agents/crew-general.md" .chezmoi.homeDir)
    "mcpServers" $servers
    "tools" (list "*")
    "toolAliases" (dict)
    "allowedTools" $tools
    "resources" $k.resources.base
    "hooks" (dict)
    "includeMcpJson" false
    "model" nil
-}}
{{ toPrettyJson $config | replace "~/" (printf "%s/" .chezmoi.homeDir) | replace "${sourceDir}" .chezmoi.sourceDir }}
