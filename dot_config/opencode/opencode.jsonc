{
    "$schema": "https://opencode.ai/config.json",
    "model": "anthropic/claude-sonnet-4-5",
    "update": "disable",
    "mcp": {
        "servers": {
            "aws-mcp": {
                "type": "local",
                "command": [
                    "uvx",
                    "mcp-proxy-for-aws==1.6.2",
                    "https://aws-mcp.eu-central-1.api.aws/mcp",
                    "--metadata", "AWS_REGION=eu-west-1"
                ],
                "timeout": {
                    "catalog": 100000,
                    "execution": 100000
                }
            }
        }
    }
}
