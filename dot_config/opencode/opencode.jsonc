{
    "$schema": "https://opencode.ai/config.json",
    "model": "anthropic/claude-sonnet-4-5",
    "autoupdate": true,
    "mcp": {
        "aws-mcp": {
            "enabled": true,
            "type": "local",
            "command": [
                "uvx",
                "mcp-proxy-for-aws==1.6.2",
                "https://aws-mcp.eu-central-1.api.aws/mcp",
                "--metadata", "AWS_REGION=eu-west-1"
            ],
            "timeout": 100000,
            "transport": "stdio",
        }
    }
}
