        "external_directory": {
            "*": "ask",
            "~/.config/*": "allow",
            "~/.local/share/apex/*": "allow",
            "~/git/*": "allow",
            "~/external/*": "allow",
            "~/.aws/credentials": "deny"
        },
        "bash": {
