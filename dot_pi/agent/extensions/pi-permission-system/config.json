{
    "debugLog": false,
    "permissionReviewLog": true,
    "yoloMode": false,
    "doublePressToConfirm": true,
    "piInfrastructureReadPaths": [
        "~/.config/*",
        "~/.local/share/apex/*"
    ],
    "permission": {
        // fallback to ask if no rule is matched
        "*": "ask",
        "read": "allow",
        "grep": "allow",
        "find": "allow",
        "ls": "allow",
        "write": {
            "*": "allow"
        },
        "edit": {
            "*": "allow"
        },
        "path": {
            "*": "allow",
            "*.env": "deny",
            "*.env.*": "deny",
            "*.env.example": "allow"
