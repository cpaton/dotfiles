{
  "lastChangelogVersion": "0.84.2",
  "theme": "catppuccin-tui-frappe",
  "packages": [
    "npm:pi-provider-kiro",
    "npm:pi-mcp-adapter",
    "npm:pi-web-access",
    "npm:pi-lens",
    "npm:@gkzhb/pi-roles",
    "npm:pi-subagents",
    "npm:@gotgenes/pi-permission-system",
    "npm:pi-memory",
    "npm:pi-catppuccin-tui",
    "/home/craig/.pi/extensions/dump-prompt.ts"
  ],
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.5",
  "defaultThinkingLevel": "high",
  "hideThinkingBlock": true,
  "showCacheMissNotices": true,
  "outputPad": 0,
  "shellPath": "/opt/microsoft/powershell/7/pwsh",
  "defaultTools": [
    "read",
    "bash",
    "edit",
    "write",
    "grep",
    "find",
    "ls"
  ],
  "skills": [
    "~/.pi/skills"
  ],
  "pi-roles": {
    "roleScope": "both",
    "defaultRole": "general",
    "intercomMode": "off"
  }
}
