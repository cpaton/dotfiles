{{- $k := .kiro -}}
{{- $mcps := list
    (dict "key" "grafana_nextgen_remote" "groups" (list "read_only" "write"))
-}}
{{- /* ── Build V3 permission rules from shared data ── */}}
{{- $rules := list -}}
{{- $shellAllow := list -}}
{{- range $k.shell_command_prefixes.allow -}}
{{-   $shellAllow = append $shellAllow (printf "%s *" .) -}}
{{- end -}}
{{- range $k.shell_command_patterns.allow -}}
{{-   $shellAllow = append $shellAllow (replace ".*" "*" .) -}}
{{- end -}}
{{- range $k.shell_command_exact.allow -}}
{{-   $shellAllow = append $shellAllow . -}}
{{- end -}}
{{- $rules = append $rules (dict "capability" "shell" "match" $shellAllow "effect" "allow") -}}
{{- $shellAsk := list -}}
{{- range $k.shell_command_prefixes.ask -}}
{{-   $shellAsk = append $shellAsk (printf "%s*" .) -}}
{{- end -}}
{{- $rules = append $rules (dict "capability" "shell" "match" $shellAsk "effect" "ask") -}}
{{- $rules = append $rules (dict "capability" "fs_read" "match" $k.paths.read_allow "effect" "allow") -}}
{{- $rules = append $rules (dict "capability" "fs_read" "match" $k.paths.read_deny "effect" "deny") -}}
{{- $rules = append $rules (dict "capability" "fs_write" "match" $k.paths.write_allow "effect" "allow") -}}
{{- $rules = append $rules (dict "capability" "subagent" "effect" "allow") -}}
{{- $rules = append $rules (dict "capability" "web_fetch" "match" (list "*") "effect" "allow") -}}
{{- $rules = append $rules (dict "capability" "web_search" "effect" "allow") -}}
{{- $rules = append $rules (dict "capability" "skill" "effect" "allow") -}}
{{- range $k.v3_extra_capabilities -}}
{{-   $rules = append $rules . -}}
{{- end -}}
{{- $servers := dict -}}
{{- $mcpAllowPatterns := list -}}
{{- range $mcps -}}
{{-   $mcp := index $k.mcp_servers .key -}}
{{-   $config := dict -}}
{{-   if hasKey $mcp "config" -}}
{{-     $config = $mcp.config -}}
{{-   else if eq $.chezmoi.os "windows" -}}
{{-     $config = $mcp.config_windows -}}
{{-   else -}}
{{-     $config = $mcp.config_linux -}}
{{-   end -}}
{{-   $_ := set $servers $mcp.name $config -}}
{{-   range $group := .groups -}}
{{-     range $tool := index $mcp.allowed_tools $group -}}
{{-       $mcpAllowPatterns = append $mcpAllowPatterns (printf "%s/%s" $mcp.name $tool) -}}
{{-     end -}}
{{-   end -}}
{{- end -}}
{{- $rules = append $rules (dict "capability" "mcp" "match" $mcpAllowPatterns "effect" "allow") -}}
{{- $frontmatter := dict
    "name" "mcp-test"
    "description" "MCP test agent"
    "tools" (list "*")
    "includeMcpJson" false
    "includePowers" false
    "mcpServers" $servers
    "resources" (concat $k.resources.base $k.resources.cli_only)
    "permissions" (dict "rules" $rules)
-}}
---
{{ toYaml $frontmatter | replace "~/" (printf "%s/" .chezmoi.homeDir) | replace "${sourceDir}" .chezmoi.sourceDir -}}
---

You are the default Kiro CLI agent. Beyond development tasks, you help with writing, analysis, planning, research, and any other professional work the user needs.
